{
    "preset": "laravel",
    "rules": {
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_extra_blank_lines": {
            "tokens": [
                "extra",
                "throw",
                "use",
                "use_trait"
            ]
        },
        "single_quote": true,
        "trailing_comma_in_multiline": {
            "elements": [
                "arrays"
            ]
        }
    },
    "exclude": [
        "bootstrap/cache",
        "node_modules",
        "public",
        "storage",
        "vendor"
    ]
}
